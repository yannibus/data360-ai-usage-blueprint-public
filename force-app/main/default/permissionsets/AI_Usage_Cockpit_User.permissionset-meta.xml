<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>AI Usage Cockpit User</label>
    <description>Grants access to the AI Usage Cockpit controller that powers the Data360 AI Usage Blueprint LWC (Tier 2). Assign this to users who should see the AI usage cockpit.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>AiUsageCockpitController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <tabSettings>
        <tab>AI_Usage_Cockpit_Page</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <applicationVisibilities>
        <application>AI_Usage_Governance</application>
        <visible>true</visible>
    </applicationVisibilities>
</PermissionSet>
