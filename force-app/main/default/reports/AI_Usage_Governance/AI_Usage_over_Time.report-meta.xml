<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>AI Usage over Time</name>
    <description>Agentforce / GenAI token usage over time (by day) and feature, from the materialized AI Usage custom DMO. Mirrors queries/03-usage-normalized.sql.</description>
    <reportType>CustomEntity$AI_Usage_Report__dlm</reportType>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>AI_Usage_Report__dlm.AIA_Timestamp__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>AI_Usage_Report__dlm.AIA_GenAiGatewayFeatureName__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <columns>
        <field>AI_Usage_Report__dlm.AIA_PromptTotalTokenCount__c</field>
        <aggregateTypes>Sum</aggregateTypes>
    </columns>
    <columns>
        <field>AI_Usage_Report__dlm.AIA_UsageQuantity__c</field>
        <aggregateTypes>Sum</aggregateTypes>
    </columns>
    <chart>
        <chartSummaries>
            <aggregate>Sum</aggregate>
            <axisBinding>y</axisBinding>
            <column>AI_Usage_Report__dlm.AIA_PromptTotalTokenCount__c</column>
        </chartSummaries>
        <chartType>Line</chartType>
        <groupingColumn>AI_Usage_Report__dlm.AIA_Timestamp__c</groupingColumn>
        <location>CHART_TOP</location>
        <size>Medium</size>
        <summaryAxisRange>Auto</summaryAxisRange>
        <title>Tokens over Time</title>
    </chart>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>AI_Usage_Report__dlm.AIA_Timestamp__c</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
