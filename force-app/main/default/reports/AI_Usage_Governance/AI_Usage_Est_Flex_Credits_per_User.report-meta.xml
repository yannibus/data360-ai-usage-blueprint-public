<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Est. Flex Credits per User</name>
    <description>Estimated Flex Credits (actions + tokens) per user, split by metered vs included, from the materialized AI Usage custom DMO. Mirrors queries/02-flex-credits-per-user.sql. Estimate only — Digital Wallet is the billing source of truth.</description>
    <reportType>CustomEntity$AI_Usage_Report__dlm</reportType>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>AI_Usage_Report__dlm.FullName__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>AI_Usage_Report__dlm.AIA_IsMeteredIndicator__c</field>
        <sortOrder>Asc</sortOrder>
