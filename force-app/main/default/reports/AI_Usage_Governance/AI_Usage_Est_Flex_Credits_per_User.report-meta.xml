    </columns>
    <columns>
        <field>AI_Usage_Report__dlm.AIA_PromptTotalTokenCount__c</field>
        <aggregateTypes>Sum</aggregateTypes>
    </columns>
    <chart>
        <chartSummaries>
            <aggregate>Sum</aggregate>
            <axisBinding>y</axisBinding>
            <column>AI_Usage_Report__dlm.AIA_UsageQuantity__c</column>
        </chartSummaries>
        <chartType>HorizontalBar</chartType>
        <groupingColumn>AI_Usage_Report__dlm.FullName__c</groupingColumn>
        <location>CHART_TOP</location>
        <size>Medium</size>
        <summaryAxisRange>Auto</summaryAxisRange>
        <title>Actions by User (metered split)</title>
